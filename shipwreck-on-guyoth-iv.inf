!----------------------------------------
! Huge spider
!----------------------------------------
!Combine with item15
Object spider "spider"
with
  article "a huge",
  short_name
  [;
    if (self has general)
      print "dead ";
    rfalse;
  ],
  name 'huge' 'spider',
  description
  [;
    print "It's not very different from the spiders on Earth or on Thalos, but it's really huge. ";
    if (self has general)
      "It's now dead and lying on its back, exposing its abdomen.";
    "Also, it's very aggressive.";
  ],
  life
  [;
    ThrowAt:
			if((noun == knife) && (knife in player))
      {
        move knife to location;
        "You throw the knife at the spider, but the only result you achieve is losing the knife";
      }
      if (knife notin player)
        "You don't have the knife with you.";
  ],
  before
  [;
    Attack, Shoot:
      if (self has general)
        "The spider is already dead.";
      if (second == knife)
        <<Cut self>>;
      give self general;
      StopDaemon(self);
      if (second == nothing && pistol in player)
      {
        print "(with the pistol)^";
        second = pistol;
      }
      "You shoot at the huge spider a few times, screaming in fear at such a horrid sight, until you realise it's not moving any more. The spider now lies on its back, dead, exposing its abdomen.";
    Cut:
      if (knife notin player)
        "You don't have anything to cut the spider with. ";
      "The knife is a short range weapon, not suitable to deal with such a powerful creature.";
    Take:
      "Nope!";
  ],
  daemon
  [;
    switch (self.time_left++)
    {
      2: "^The spider seems to study you, savouring its next meal.";
      3: "^The spider gets closer, and it's horrible.";
      4: "^The spider is preparing to attack.";
      5: deadflag = 1;
        "^First blocking you with its front legs, and then piercing you with its second pair, the spider thrusts itself upon you. You can't escape it, and you're still alive when it starts eating you.";
    }
  ],
  time_left 0,
  add_to_scope abdomen,
has animate neuter;

!----------------------------------------
! Abdomen
!----------------------------------------
Object abdomen "abdomen"
with
  article "the",
  name 'abdomen' 'of' 'spider',
  description
  [;
    if (spider hasnt general)
      "You can't reach the abdomen of the spider while it's still alive and standing on its legs.";
    print "The spider's abdomen is now exposed and ";
    if (self hasnt general)
      "it seems to contain something.";
    "cut open.";
  ],
  before
  [;
    Attack, Shoot:
      if (spider hasnt general)
        "The abdomen is not in your line of sight, so you can't shoot it.";
      "The abdomen seems to contain something that you may not want to damage.";
    Cut:
      if (spider hasnt general)
        "You can't cut it while the spider is still alive.";
      if (self hasnt general)
      {
        if (knife notin player)
          print_ret (string)NEED_PROPER_TOOL;
        if (second == nothing && knife in player)
        {
          print "(with the knife)^";
          second = knife;
        }
        give self general;
        move plate to location;
        "Using the makeshift knife, you cut the spider's abdomen. It's a disgusting task, but in the end you find a small metal plate bearing the logo of the Discovery on it. The plate falls on the ground and you can now take it.";
      }
      "You've already cut it. Don't bother with that any more.";
    Search:
      "It's rather disgusting.";
  ],
has scenery;

