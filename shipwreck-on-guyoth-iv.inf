with
  description "The large cave hides the remains of some Earthlings, now covered by a veil of mist that makes them take on an unreal appearance. A bioluminescence on the walls is bright enough to let you see without a torch. From here, the only exit is towards the west.",
  !w_to room21,
  w_to
  [;
    if (spider in nothing) 
    {
      move spider to location;
      PlaceInScope(Spider);
      StartDaemon(spider);
      print "As you try to exit the cave a giant spider comes in and blocks your way out.^^";
      <<Look>>;
    }
    if (spider hasnt general)
      "You can't exit the cave with the spider blocking the entrance.";
    else
      return room21;
  ],
  out_to
  [;
   if (spider in nothing) 
    {
      move spider to location;
      PlaceInScope(Spider);
      StartDaemon(spider);
      print "As you try to exit the cave a giant spider comes in and blocks your way out.^^";
      <<Look>>;
    }
    if (spider hasnt general)
      "You can't exit the cave with the spider blocking the entrance.";
    else
      return room21;
  ],
  before
  [;
    Hint:
      if (spider hasnt general)
        "Killing the beast is the only way to exit the cave.";
      "You don't need any more hints for this location.";
  ],
has light;

