Object pterodactyl "pterodactyl" room19
with
  name 'huge' 'giant' 'pterodactyl',
  description "It's a giant bird-like flying dinosaur, very similar to the artist's impression of a pterodactyl you have seen in the books. It's developing feathers, so the theories of evolutions you've always studied proved correct.",
  before
  [;
    Attack, Shoot:
      give self general;
      StopDaemon(self);
      if (second == nothing && pistol in player)
      {
        print "(with the pistol)^";
        second = pistol;
      }
      print "You shoot at the giant beast without hitting any vital point. Yet, surprised by the blast, the pterodactyl loses altitude. As you approach the top of the trees, you fire again, this time hitting the beast. Its claws open right when you are above the trees and you fall down stopping right next to your parachute canopy. The pterodactyl disappears below the horizon. That was close!^^";
      PlayerTo(room01);
      rtrue;
    Take:
      "You are the one being taken. Think about something else.";
  ],
  daemon
  [;
    switch (self.time_left++)
    {
      1: "^The pterodactyl shrieks, as if to send out a war cry.";
      2: "^The pterodactyl is now flying above some trees. You look down and you see the canopy of your parachute.";
      3: "^The pterodactyl is about to open its claws to let you fall.";
      4: "^It's now or never. Do something!";
      5: deadflag = 1;
        "The huge claws open up, and for a brief moment you feel relieved. You start falling towards the ground at increasing speed. Then, you hit the rocks and die instantly.";
    }
  ],
  time_left 0,
has animate neuter;

